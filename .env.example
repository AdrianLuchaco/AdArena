# =====================================================================
# Variables de entorno del BACKEND en la nube (Render).
# Esto es una PLANTILLA: los valores reales se ponen en el panel de Render (Environment), nunca en
# un fichero subido a Git (.gitignore ya impide subir los .env).
# Resumen del despliegue en el README ("Deploy your own instance").
# NUNCA pongas SPRING_PROFILES_ACTIVE=dev en la nube (crearía los datos de ejemplo).
# =====================================================================

# --- Base de datos: Supabase → botón "Connect" → "Session pooler" (funciona con IPv4) ---
DB_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.TU_REFERENCIA_DE_PROYECTO
DB_PASSWORD=la-contraseña-de-la-base-de-datos
DB_POOL_SIZE=5

# --- Seguridad ---
# Render lo genera solo (render.yaml). A mano: openssl rand -base64 48
JWT_SECRET=cambia-esto
# La MISMA clave en Render y en Vercel. Genera una con: openssl rand -hex 32
PROXY_SECRET=cambia-esto
# Dirección exacta de la web (sin barra final). Varias, separadas por comas.
FRONTEND_ORIGINS=https://adarena.vercel.app
# Dirección de la web para los enlaces de los emails (vacío = el primer origen de arriba)
PUBLIC_URL=https://adarena.vercel.app

# --- Tu cuenta de administrador (se crea al primer arranque si no existe) ---
ADMIN_EMAIL=tu-email@ejemplo.com
# Mínimo 12 caracteres
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-larga
ADMIN_NAME=Admin

# --- Emails con Brevo (brevo.com, gratis: 300 al día, sin dominio propio) ---
# Brevo → Settings → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=xkeysib-...
# El remitente debe estar verificado en Brevo (Senders)
MAIL_FROM=AdArena <tu-email@gmail.com>

# --- Alternativa a Brevo: SMTP (NO funciona en el plan gratuito de Render: bloquea esos puertos) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_...

# --- Arena Points (opcionales: estos son los valores por defecto) ---
# SIGNUP_BONUS_POINTS=200
# TASK_REWARD_POINTS=20
# TASKS_PER_DAY=10
# WINNER_BONUS_POINTS=500
# SITE_PREVIEWS_ENABLED=true

# --- Opcionales ---
# SPRINGDOC_ENABLED=false
# RATE_LIMIT_ENABLED=true
# JOBS_ENABLED=true
# Memoria de Java (el Dockerfile ya trae valores para 512 MB)
# JAVA_OPTS=-XX:MaxRAMPercentage=55 -XX:+UseSerialGC ...
