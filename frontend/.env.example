# Variables de la WEB (Next.js).
# En tu ordenador no hace falta crear ningún fichero: por defecto usa http://localhost:8081.
# En Vercel se ponen en Settings → Environment Variables (guía: docs/DESPLIEGUE.md).

# "/" = la API va por la misma dirección que la web (la web reenvía /api/* al backend: src/proxy.ts)
NEXT_PUBLIC_API_URL=/
# El tiempo real va directo al backend (la web no puede reenviar WebSockets)
NEXT_PUBLIC_WS_URL=wss://adarena-api.onrender.com/ws
# A dónde reenvía la web las llamadas /api/* (tu backend en Render, sin barra final)
BACKEND_URL=https://adarena-api.onrender.com
# La MISMA clave que PROXY_SECRET en Render (openssl rand -hex 32)
PROXY_SECRET=cambia-esto

# Google AdSense (opcional; necesita dominio propio y, en Vercel, el plan Pro: el gratuito no
# permite anuncios). Sin NEXT_PUBLIC_ADSENSE_CLIENT no se carga nada de Google.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1234567890123456
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_INFEED=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_BANNER=1234567890
